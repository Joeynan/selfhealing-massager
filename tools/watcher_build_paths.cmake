# Keep vendor components unmodified while correcting their legacy raw -L flags.
# CMake's link-directory API quotes paths containing spaces correctly.
function(selfhealing_fix_link_paths)
    foreach(target __idf_espressif__esp_audio_codec __idf_espressif__esp_image_effects)
        if(NOT TARGET "${target}")
            continue()
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(items "${target}" "${property}")
            if(NOT items)
                continue()
            endif()
            set(corrected "")
            foreach(item IN LISTS items)
                if(item MATCHES "^-L (.+)$")
                    target_link_directories("${target}" INTERFACE "${CMAKE_MATCH_1}")
                elseif(item MATCHES "^\\$<LINK_ONLY:-L (.+)>$")
                    target_link_directories("${target}" INTERFACE "${CMAKE_MATCH_1}")
                else()
                    list(APPEND corrected "${item}")
                endif()
            endforeach()
            set_property(TARGET "${target}" PROPERTY "${property}" "${corrected}")
        endforeach()
    endforeach()
endfunction()

if(PROJECT_NAME STREQUAL "xiaozhi")
    cmake_language(DEFER CALL selfhealing_fix_link_paths)
endif()
