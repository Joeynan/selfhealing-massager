+static bool sscma_client_stop_tasks(sscma_client_handle_t client, TickType_t timeout)
+{
+    TaskHandle_t current = xTaskGetCurrentTaskHandle();
+    if ((client->process_task.handle && current == client->process_task.handle) ||
+        (client->monitor_task.handle && current == client->monitor_task.handle))
+    {
+        return false;
+    }
+    if (client->process_task.handle)
+    {
+        vTaskSuspend(client->process_task.handle);
+    }
+    if (client->monitor_task.handle)
+    {
+        vTaskSuspend(client->monitor_task.handle);
+    }
+    TickType_t started = xTaskGetTickCount();
+    for (;;)
+    {
+        bool process_stopped = !client->process_task.handle || eTaskGetState(client->process_task.handle) == eSuspended;
+        bool monitor_stopped = !client->monitor_task.handle || eTaskGetState(client->monitor_task.handle) == eSuspended;
+        if (process_stopped && monitor_stopped)
+        {
+            break;
+        }
+        if ((TickType_t)(xTaskGetTickCount() - started) >= timeout)
+        {
+            return false;
+        }
+        vTaskDelay(1);
+    }
+    // The owner must prevent concurrent API/resume calls. On this IDF kernel,
+    // deleting an eSuspended task is synchronous, unlike remote eRunning tasks.
+    if (client->process_task.handle)
+    {
+        vTaskDelete(client->process_task.handle);
+        client->process_task.handle = NULL;
+    }
+    if (client->monitor_task.handle)
+    {
+        vTaskDelete(client->monitor_task.handle);
+        client->monitor_task.handle = NULL;
+    }
+    return true;
+}
