# The supported upload path is tools/package_team.py export -> a clean folder.
# Defense in depth if somebody initializes Git in the full local project.
/*
!/README.md
!/AGENTS.md
!/.gitignore
!/.gitattributes
!/source-manifest.json
!/*.command
!/*.ps1
!/docs/
!/tools/
!/work/
!/outputs/
!/.github/
!/releases/

/work/*
!/work/xiaozhi-esp32/
!/work/requirements/
/work/xiaozhi-esp32/build/
/work/xiaozhi-esp32/managed_components/
/work/xiaozhi-esp32/components/
/work/xiaozhi-esp32/docker/
/work/xiaozhi-esp32/.github/
/work/xiaozhi-esp32/sdkconfig
/work/xiaozhi-esp32/sdkconfig.old
/work/xiaozhi-esp32/main/assets/lang_config.h
/work/xiaozhi-esp32/main/mmap_generate_*.h

/outputs/*
!/outputs/Watcher控制台/
/outputs/Watcher控制台/evidence/
/outputs/Watcher控制台/model-port/
/outputs/Watcher控制台/烧录记录/
/outputs/Watcher控制台/五秒联动版/
/outputs/Watcher控制台/实测记录.md
/outputs/Watcher控制台/板上21节点移植进度.md
/outputs/Watcher控制台/WiFi摄像头版/*
!/outputs/Watcher控制台/WiFi摄像头版/prepare_flash.py
/outputs/Watcher控制台/滚轮表情版/*
!/outputs/Watcher控制台/滚轮表情版/flash_release.py
!/outputs/Watcher控制台/滚轮表情版/release-manifest.json
!/outputs/Watcher控制台/滚轮表情版/tests/
!/outputs/Watcher控制台/滚轮表情版/上一版回滚/
/outputs/Watcher控制台/滚轮表情版/上一版回滚/*
!/outputs/Watcher控制台/滚轮表情版/上一版回滚/release-manifest.json
/outputs/Watcher控制台/firmware/watcher-vision/*
!/outputs/Watcher控制台/firmware/watcher-vision/src/

/docs/*
!/docs/使用指南.md
!/docs/GitHub上传指南.md
!/docs/第三方来源与许可.md
!/docs/验收清单.md
!/docs/交付验证/
/tools/verify_project.py
/tools/setup_environments.py
/tools/install_arduino_tools.py
/tools/restore_vision_tools.py
/tools/tests/test_verify_runtime_logs.py

**/__pycache__/
**/.venv/
**/venv/
**/.cache/
.DS_Store
*.pyc
*.log
*.bin
*.img
*.zip
*.elf
*.map
*.task
**/.env
**/wifi_settings.h
!/outputs/Watcher控制台/tests/node_stubs/wifi_settings.h
/outputs/Watcher控制台/settings.json
**/*.local.json

# The fixed ESP-IDF component lock is required for a fresh source build.
!/work/xiaozhi-esp32/dependencies.lock
